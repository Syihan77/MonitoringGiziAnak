APP_NAME=Laravel
APP_ENV=local
# Demo resep DATA_LENGKAP hanya untuk non-production; wajib false di production.
NUTRITION_DEMO_ALLOW_DATA_LENGKAP=false

# Layanan ML internal (satu FastAPI melayani ML1 dan ML2).
# Laravel memakai port 8000; jalankan layanan ML di 8001 agar tidak bertabrakan.
ML_ENABLED=false
ML1_BASE_URL=http://127.0.0.1:8001
ML1_CONNECT_TIMEOUT=1
ML1_TIMEOUT=2
ML2_BASE_URL=http://127.0.0.1:8001
ML2_CONNECT_TIMEOUT=1
ML2_TIMEOUT=5
# Jangan isi manual — jalankan: php artisan key:generate (wajib beda tiap mesin)
APP_KEY=
# Aktifkan true hanya untuk debugging lokal; wajib false di production.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gizi_db
DB_USERNAME=gizi
# Isi password role PostgreSQL lokal masing-masing (jangan samakan antar laptop)
DB_PASSWORD=

# Pilih sendiri, min. 12 karakter. Wajib diisi sebelum php artisan db:seed
ADMIN_PASSWORD=

DESA_NAMA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
