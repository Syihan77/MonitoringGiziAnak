# Salin ke .env / EnvironmentFile server. Semua opsional (nilai di bawah adalah bawaan).

# Folder artefak (bawaan: app/ml1/model dan app/ml2/model di dalam paket)
# ML1_MODEL_DIR=/opt/ml-monitoring-gizi/app/ml1/model
# ML2_MODEL_DIR=/opt/ml-monitoring-gizi/app/ml2/model

# Swagger /docs, /redoc, /openapi.json: true|false (disarankan false di server publik)
API_DOCS_ENABLED=true

# DEBUG | INFO | WARNING | ERROR  (log tidak pernah memuat data input anak)
LOG_LEVEL=INFO

# --- Sisi Laravel (.env milik aplikasi Laravel, bukan layanan Python ini) ---
# ML_API_URL=http://127.0.0.1:8000
# ML_API_TIMEOUT=5
